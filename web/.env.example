# Mission data adapter: demo or backend. Demo is always explicitly labeled.
VITE_DATA_MODE=demo
VITE_GRAPHQL_URL=/graphql
# Empty WS URL uses ws(s)://current-host/ws.
VITE_WS_URL=
VITE_API_BASE=
VITE_HABITAT_ID=nave-transito
# Proposed authenticated current-session endpoint: configure only after implementation.
VITE_SESSION_URL=
# Optional authorized mission-control directory returning {crew: CrewMember[]}.
VITE_CREW_DIRECTORY_URL=
# Existing assistant development API; clear to use the labeled demo assistant in demo mode.
VITE_ASSISTANT_URL=/dev/ask
VITE_VOICE_URL=/api/v1/voice/utterances
VITE_SPEAK_URL=/api/v1/voice/speak
# Vite proxy targets are process environment variables (not public VITE_* values).
# SPACEAPP_API_PROXY=http://127.0.0.1:8002
# SPACEAPP_ASSISTANT_PROXY=http://127.0.0.1:8000
