# `npm run dev:backend`: the console reads the real backend instead of the labeled demo data.
# The values here are the defaults of scripts/dev-backend.sh; override any of them in the shell.
VITE_DATA_MODE=backend
VITE_GRAPHQL_URL=/graphql
VITE_WS_URL=
VITE_API_BASE=
VITE_HABITAT_ID=transit-ship
VITE_ASSISTANT_URL=/dev/ask
VITE_VOICE_URL=/api/v1/voice/utterances
VITE_SPEAK_URL=/api/v1/voice/speak
# Vite proxy targets (the browser only talks to the Vite origin, so CORS is not needed).
# API with GraphQL, /ws and /api; the assistant development server (devtools.assistant_server).
SPACEAPP_API_PROXY=http://127.0.0.1:8002
SPACEAPP_ASSISTANT_PROXY=http://127.0.0.1:8000
