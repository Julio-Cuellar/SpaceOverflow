# Route of the real assistant (backend -> n8n -> Ollama). Empty: local simulation.
VITE_ASSISTANT_URL=/dev/ask
# Route of the real voice (backend -> Whisper). Empty: simulated transcript.
VITE_VOICE_URL=/api/v1/voice/utterances
# Route of the output voice (backend -> Kokoro). Empty: answers are text only.
VITE_SPEAK_URL=/api/v1/voice/speak
