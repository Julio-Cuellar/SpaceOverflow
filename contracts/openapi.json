{
  "components": {
    "schemas": {
      "BatchBody": {
        "properties": {
          "batch_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Id"
          },
          "habitat_id": {
            "format": "uuid",
            "title": "Habitat Id",
            "type": "string"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingBody"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Readings",
            "type": "array"
          }
        },
        "required": [
          "habitat_id",
          "readings"
        ],
        "title": "BatchBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InboundPlan": {
        "additionalProperties": false,
        "properties": {
          "batch_id": {
            "format": "uuid",
            "title": "Batch Id",
            "type": "string"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Items",
            "type": "array"
          },
          "plan_version": {
            "minimum": 1.0,
            "title": "Plan Version",
            "type": "integer"
          }
        },
        "required": [
          "batch_id",
          "plan_version",
          "items",
          "hash"
        ],
        "title": "InboundPlan",
        "type": "object"
      },
      "LinkChange": {
        "additionalProperties": false,
        "properties": {
          "delay_s": {
            "anyOf": [
              {
                "maximum": 60.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay S"
          },
          "state": {
            "enum": [
              "UP",
              "DOWN"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "LinkChange",
        "type": "object"
      },
      "ReadingBody": {
        "properties": {
          "quality": {
            "default": "ok",
            "title": "Quality",
            "type": "string"
          },
          "sensor_id": {
            "format": "uuid",
            "title": "Sensor Id",
            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "sensor_id",
          "ts",
          "value"
        ],
        "title": "ReadingBody",
        "type": "object"
      },
      "ScenarioBody": {
        "properties": {
          "speed": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Speed",
            "type": "number"
          },
          "zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone"
          }
        },
        "title": "ScenarioBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
