map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 20m;
  location /graphql { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
  location /ws { proxy_pass ${API_UPSTREAM}; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_read_timeout 3600s; }
  location /api/v1/voice { proxy_pass ${ASSISTANT_UPSTREAM}; proxy_read_timeout 160s; }
  location /dev/ { proxy_pass ${ASSISTANT_UPSTREAM}; proxy_read_timeout 160s; }
  location /api/ { proxy_pass ${API_UPSTREAM}; }
  location = /health { proxy_pass ${API_UPSTREAM}; }
  location = /ready { proxy_pass ${API_UPSTREAM}; }
  location / { try_files $uri $uri/ /index.html; }
}
