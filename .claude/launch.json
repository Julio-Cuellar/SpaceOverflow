{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "web-backend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SPACEAPP_API_PROXY=http://127.0.0.1:8010",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev:backend",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}
